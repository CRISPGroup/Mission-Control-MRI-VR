--- !u!114 &71925385
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 71925383}
  m_Enabled: 0
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f60aa0bf21144c0449404908e3253a24, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  DisplayOnStart: 0
  titleText: {fileID: 1872786470}
  shortStatementText: {fileID: 1753956710}
  segments:
  - title: 
    shortStatement: Lie down now, look at the ceiling, and click to confirm your
      position.
    buttonSet: {fileID: 1847554131}
  - title: 
    shortStatement: "The spaceship can be loud!\nLet\u2019s <b>protect your ears
      </b>and keep you connected with mission control."
    buttonSet: {fileID: 1574414940}
  - title: 
    shortStatement: Click to confirm you can hear the audio.
    buttonSet: {fileID: 1002428802}
  - title: 
    shortStatement: "It is time to put on your helmet! \nPlease stay still..."
    buttonSet: {fileID: 1965021669}
  - title: 
    shortStatement: "You\u2019re all set!\nIt is time to board the spaceship."
    buttonSet: {fileID: 1902625531}
  segmentsFR:
  - title: 
    shortStatement: Allonge-toi maintenant, regarde le plafond, puis clique pour
      confirmer ta position.
    buttonSet: {fileID: 1847554131}
  - title: 
    shortStatement: "Le vaisseau spatial peut \xEAtre bruyant !\r\nProt\xE9geons
      <b>tes oreilles</b> et restons \r\nconnect\xE9s avec le centre de contr\xF4le."
    buttonSet: {fileID: 1574414940}
  - title: 
    shortStatement: Clique pour confirmer que tu entends le son.
    buttonSet: {fileID: 1002428802}
  - title: 
    shortStatement: "Il est temps de mettre ton casque ! \nReste bien immobile\u2026\r"
    buttonSet: {fileID: 1965021669}
  - title: 
    shortStatement: "Tout est pr\xEAt !\r\r\nIl est temps d\u2019embarquer dans le
      \r\nvaisseau spatial."
    buttonSet: {fileID: 1902625531}
