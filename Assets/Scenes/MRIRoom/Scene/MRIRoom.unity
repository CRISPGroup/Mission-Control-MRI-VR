  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1237497827}
  m_Enabled: 0
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f60aa0bf21144c0449404908e3253a24, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  DisplayOnStart: 0
  titleText: {fileID: 1694721864}
  shortStatementText: {fileID: 1201188060}
  segments:
  - title: 
    shortStatement: "Click to hear \nthe sounds the spaceship makes:"
    buttonSet: {fileID: 1600129930}
  - title: 
    shortStatement: 
    buttonSet: {fileID: 730832306}
  - title: 
    shortStatement: 'Hold for 3s to pause. Hold again to resume.




'
    buttonSet: {fileID: 823612385}
  - title: 
    shortStatement: "Are you ready \nto launch?"
    buttonSet: {fileID: 994811345}
  - title: 
    shortStatement: " Calibration step:\n<b>Look at the moon</b> and click to confirm.
      \n\n\n\n\n\nKeep the target <b>green</b> and <b>centered</b>!"
    buttonSet: {fileID: 1875562345}
  - title: 
    shortStatement: 
    buttonSet: {fileID: 285254014}
  segmentsFR:
  - title: 
    shortStatement: "Clique pour \xE9couter\nles sons que fait le vaisseau spatial
      :"
    buttonSet: {fileID: 1600129930}
  - title: 
    shortStatement: 
    buttonSet: {fileID: 730832306}
  - title: 
    shortStatement: "Maintiens 3s pour mettre en pause. Maintiens \xE0 nouveau pour
      reprendre.\r\n\r\n\r\n\r\n\r\n"
    buttonSet: {fileID: 823612385}
  - title: 
    shortStatement: "Es-tu pr\xEAt(e)\n\xE0 d\xE9coller ?"
    buttonSet: {fileID: 994811345}
  - title: 
    shortStatement: " \xC9tape de calibration :\n<b>Regarde la lune</b> et clique
      pour confirmer.\n\n\n\n\n\nGarde la cible <b>verte</b> et <b>centr\xE9e</b>
      !"
    buttonSet: {fileID: 1875562345}
  - title: 
    shortStatement: 
    buttonSet: {fileID: 285254014}
