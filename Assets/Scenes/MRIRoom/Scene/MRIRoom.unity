  titleText: {fileID: 618613351}
  shortStatementText: {fileID: 1141488663}
  segments:
  - title: 
    shortStatement: Touch your hand to the box to remove your watch.
    buttonSet: {fileID: 0}
  - title: 
    shortStatement: "Great job! Now, let\u2019s put on your spacesuit!\r\nTouch the
      spacesuit on the chair to put it on!"
    buttonSet: {fileID: 0}
  - title: 
    shortStatement: Almost there, ready for the next step? Click to confirm.
    buttonSet: {fileID: 507047548}
  segmentsFR:
  - title: 
    shortStatement: "Touche la bo\xEEte avec ta main pour retirer ta montre."
    buttonSet: {fileID: 0}
  - title: 
    shortStatement: "Bravo ! Maintenant, enfile ta combinaison spatiale !\r\nTouche
      la combinaison sur la chaise pour l\u2019enfiler."
    buttonSet: {fileID: 0}
  - title: 
    shortStatement: "On y est presque. Pr\xEAt(e) pour la suite ? Clique pour confirmer.\r"
    buttonSet: {fileID: 507047548}
